---
import Base from '../layouts/Base.astro';
import { firstSentence } from '../lib/catalog';
import { areas, crews, isReadOnly, leadSentences, routers, searchText, seatCount, setupReviewers } from '../lib/team';
import type { Agent } from '../lib/catalog';

const pins = (agent: Agent) => [agent.model, agent.effort && `${agent.effort} effort`].filter(Boolean).join(', ');
---

<Base
  title="The team | Agent Catalog"
  description={`${seatCount} staff-engineer seats and the agents that route work to them, with what each one is for and which seat to pick instead.`}
>
  <div class="wrap page">
    <header class="intro">
      <h1>The team</h1>
      <p class="lede">
        {seatCount} staff-engineer seats, one per discipline, plus the agents that design the work and route it to them. Each
        seat says what to bring it and which seat to pick instead. Search by the job you have in mind.
      </p>
    </header>

    <form class="finder" role="search" data-finder hidden>
      <label>
        <span>What do you need done?</span>
        <input type="search" name="q" placeholder="CI, slow query, alerts, sitemap, flaky test…" autocomplete="off" />
      </label>
      <p class="count" aria-live="polite" data-count>{seatCount} seats</p>
    </form>

    {
      areas.map((area) => (
        <section class="area" aria-labelledby={`area-${area.seats[0]?.bundle.name}`} data-area>
          <h2 id={`area-${area.seats[0]?.bundle.name}`}>{area.name}</h2>
          <ul class="seats">
            {area.seats.map(({ bundle, agent, notFor }) => (
              <li
                id={`seat-${bundle.name}`}
                data-seat
                data-text={searchText(bundle.name, agent.name, bundle.job, ...bundle.checklists)}
              >
                <h3>{bundle.name}</h3>
                <p class="job">{bundle.job}</p>
                {notFor.length > 0 && (
                  <p class="not-for">
                    <strong>Not for:</strong>{' '}
                    {notFor.map((segment) =>
                      segment.seat ? (
                        <>
                          (<a href={`#seat-${segment.seat}`}>{segment.seat}</a>)
                        </>
                      ) : (
                        segment.text
                      ),
                    )}
                  </p>
                )}
                <details>
                  <summary>Held to {bundle.checklists.length} checklists</summary>
                  <ul class="checklists">
                    {bundle.checklists.map((title) => (
                      <li>{title}</li>
                    ))}
                  </ul>
                </details>
                <p class="meta">
                  <code class="install">kura add {bundle.name} --type bundle</code>
                  {pins(agent) && <span class="chip">{pins(agent)}</span>}
                </p>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
    <p class="empty" data-empty hidden>
      No seat matches. Try one word, such as <em>pipeline</em>, <em>schema</em> or <em>alert</em>.
    </p>

    <section class="block" aria-labelledby="routers-h">
      <h2 id="routers-h">Agents that shape and route the work</h2>
      <p class="section-lede">
        These install in every repo. They design a feature, split it across the seats you have, judge the questions seats send
        back, and review what comes out. None of them writes product code.
      </p>
      <ul class="agents">
        {
          routers.map((agent) => (
            <li id={`agent-${agent.name}`}>
              <code>{agent.name}</code>
              <span>{leadSentences(agent.description, 2)}</span>
              <small>
                {pins(agent)}
                {isReadOnly(agent) && <>, read-only</>}
              </small>
            </li>
          ))
        }
      </ul>
    </section>

    {
      crews.map(({ bundle, agents: members }) => (
        <section class="block" aria-labelledby={`crew-${bundle.name}`}>
          <h2 id={`crew-${bundle.name}`}>{bundle.name}</h2>
          <p class="section-lede">
            {bundle.description} Install it with <code>kura add {bundle.name} --type bundle</code>; each agent is dispatched by
            one stage, never called on its own.
          </p>
          <ul class="agents">
            {members.map((agent) => (
              <li id={`agent-${agent.name}`}>
                <code>{agent.name}</code>
                <span>{leadSentences(agent.description, 2)}</span>
                <small>
                  {pins(agent)}
                  {isReadOnly(agent) && <>, read-only</>}
                </small>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section class="block" aria-labelledby="reviewers-h">
      <h2 id="reviewers-h">Reviewers for your own setup</h2>
      <ul class="agents">
        {
          setupReviewers.map((agent) => (
            <li id={`agent-${agent.name}`}>
              <code>{agent.name}</code>
              <span>{firstSentence(agent.description)}</span>
              <small>{pins(agent)}</small>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-finder]');
  const seats = [...document.querySelectorAll<HTMLElement>('[data-seat]')];
  const sections = [...document.querySelectorAll<HTMLElement>('[data-area]')];
  const count = document.querySelector<HTMLElement>('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const stem = (term: string) => (term.length > 4 ? term.replace(/(ies|es|s|y)$/, '') : term);
  const escape = (term: string) => term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  if (form && count && empty) {
    form.hidden = false;
    const apply = () => {
      const query = String(new FormData(form).get('q') ?? '').trim().toLowerCase();
      const patterns = query
        .split(/\s+/)
        .filter(Boolean)
        .map((term) => new RegExp(`(^|[^a-z0-9])${escape(stem(term))}`));
      let shown = 0;
      for (const seat of seats) {
        const text = seat.dataset.text ?? '';
        const visible = patterns.every((pattern) => pattern.test(text));
        seat.hidden = !visible;
        if (visible) shown++;
      }
      for (const section of sections) section.hidden = !section.querySelector('[data-seat]:not([hidden])');
      count.textContent = query ? `${shown} of ${seats.length} seats` : `${seats.length} seats`;
      empty.hidden = shown > 0;
    };
    form.addEventListener('input', apply);
    form.addEventListener('submit', (event) => event.preventDefault());
  }
</script>

<style>
  .page {
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }

  .intro {
    max-width: 48rem;
    margin-bottom: 2rem;
  }

  .intro .lede {
    margin-top: 1.25rem;
  }

  .finder {
    position: sticky;
    top: 4rem;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 1rem 1.5rem;
    padding: 1rem 0;
    background: var(--plaster);
    border-bottom: 1px solid var(--rule);
    margin-bottom: 1rem;
  }

  .finder label {
    flex: 1 1 18rem;
  }

  .finder label > span {
    display: block;
    font-size: var(--step--1);
    font-weight: 700;
    margin-bottom: 0.3rem;
  }

  input[type='search'] {
    font: inherit;
    font-size: var(--step--1);
    width: 100%;
    padding: 0.55rem 0.75rem;
    border: 1.5px solid var(--rule);
    border-radius: var(--radius-panel);
    background: var(--grout);
    color: var(--sumi);
  }

  input[type='search']:focus {
    border-color: var(--ai);
  }

  .count {
    margin: 0 0 0.5rem auto;
    font-size: var(--step--1);
    color: var(--sumi-soft);
  }

  .area {
    margin-top: 2.5rem;
  }

  .area[hidden],
  .seats li[hidden] {
    display: none;
  }

  .area h2 {
    font-size: var(--step-2);
    margin-bottom: 1rem;
  }

  .seats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(21rem, 1fr));
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }

  .seats > li {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.1rem 1.2rem 1rem 1.35rem;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    position: relative;
    scroll-margin-top: 10rem;
  }

  .seats > li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.1rem;
    bottom: 1rem;
    width: 3px;
    background: var(--ochre);
  }

  .seats > li:target {
    background: var(--grout);
    outline: 2px solid var(--ai);
    outline-offset: -2px;
  }

  .seats h3 {
    font-size: var(--step-1);
    font-weight: 800;
  }

  .seats p {
    margin: 0;
    font-size: var(--step--1);
  }

  .not-for {
    color: var(--sumi-soft);
  }

  .not-for strong {
    color: var(--sumi);
  }

  details {
    font-size: var(--step--1);
    color: var(--sumi-soft);
  }

  summary {
    cursor: pointer;
    width: fit-content;
  }

  .checklists {
    margin: 0.4rem 0 0;
    padding-left: 1.1rem;
  }

  .meta {
    margin-top: auto !important;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
  }

  .install {
    font-size: 0.85em;
  }

  .empty {
    padding: 2rem 0;
  }

  .block {
    margin-top: 5rem;
  }

  .block h2 {
    font-size: var(--step-3);
    margin-bottom: 0.75rem;
  }

  .section-lede {
    max-width: var(--measure);
    margin-bottom: 1.25rem;
    color: var(--sumi-soft);
  }

  .agents {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .agents li {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr) minmax(0, 11rem);
    gap: 0.25rem 1.5rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--rule);
    font-size: var(--step--1);
    scroll-margin-top: 6rem;
  }

  .agents code {
    background: none;
    padding: 0;
    color: var(--ai-ink);
    font-weight: 600;
    white-space: normal;
  }

  .agents small {
    color: var(--sumi-soft);
  }

  @media (max-width: 760px) {
    .agents li {
      grid-template-columns: 1fr;
    }
  }
</style>
