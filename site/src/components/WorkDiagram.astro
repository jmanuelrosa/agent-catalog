---
export type WorkStage = {
  title: string;
  skill?: string;
  does: string;
  writes?: string[];
  gate?: boolean;
};

interface Props {
  stages: WorkStage[];
  caption: string;
}

const { stages, caption } = Astro.props;
---

<figure class="work">
  <ol class="rail">
    {
      stages.map(({ title, skill, does, writes = [], gate = false }) => (
        <li class:list={['station', { gate }]}>
          <h4>
            {skill && <code>{skill}</code>} {title}
          </h4>
          <p>{does}</p>
          {writes.length > 0 && (
            <ul class="files" aria-label="Files written">
              {writes.map((file) => (
                <li>{file}</li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ol>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .work {
    margin: 0;
  }

  .rail {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  .rail::before {
    content: '';
    position: absolute;
    left: 0.6rem;
    top: 0.8rem;
    bottom: 0.8rem;
    width: 2px;
    background: var(--slate);
  }

  .station {
    position: relative;
    padding: 0 0 2rem 2.6rem;
  }

  .station::before {
    content: '';
    position: absolute;
    left: 0.2rem;
    top: 0.35rem;
    width: 0.9rem;
    height: 0.9rem;
    background: var(--plaster);
    border: 2px solid var(--slate);
    transform: rotate(45deg);
  }

  .gate::before {
    background: var(--ochre);
    border-color: var(--ochre);
    width: 1.1rem;
    height: 1.1rem;
    left: 0.1rem;
  }

  .gate h4 {
    color: var(--ochre-ink);
  }

  .station h4 {
    font-size: var(--step-1);
    margin-bottom: 0.3rem;
  }

  .station h4 code {
    background: none;
    padding: 0;
    color: var(--ai-ink);
    font-size: 0.85em;
  }

  .station p {
    margin: 0;
    color: var(--sumi-soft);
  }

  .files {
    list-style: none;
    padding: 0;
    margin: 0.9rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .files li {
    margin: 0;
    font-family: var(--font-code);
    font-size: var(--step--1);
    padding: 0.45rem 0.7rem;
    border: 1px dashed var(--rule);
    border-radius: var(--radius-tile);
    color: var(--sumi-soft);
  }

  figcaption {
    color: var(--sumi-soft);
    max-width: var(--measure);
  }
</style>
